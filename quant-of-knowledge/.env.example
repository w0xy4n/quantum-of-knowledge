# Production database. Without it, `npm run dev` uses local PGlite data.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evermind
# DATABASE_SSL=false

# At least 32 random characters. Required in production.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: require email confirmation and deliver it through SMTP.
REQUIRE_EMAIL_VERIFICATION=false
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM="Evermind <noreply@example.com>"

# Optional phone OTP delivery. The endpoint receives { phoneNumber, code }.
# SMS_WEBHOOK_URL=https://sms-provider.example/send
# SMS_WEBHOOK_SECRET=replace-me

# Optional OAuth providers.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Optional Telegram Login Widget.
# TELEGRAM_BOT_TOKEN=
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Uploaded files are stored here and must be on a persistent volume.
UPLOAD_DIR=./data/uploads
